<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      Outer group buys headroom. The lid bar sat flush against the top of the 24x24 grid, so the
      instant it rotated, the raised end left the canvas and was cut off. Scaling the artwork to
      80% about the centre and dropping it 2 units leaves clear space above the bar for the swing.
      The body drawable carries the IDENTICAL transform, so the two still share one grid and the
      join between lid and body stays invisible at rest.
    -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateY="2">
