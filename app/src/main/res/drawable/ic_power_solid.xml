<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled counterpart of ic_power, for Settings rows only.

  The outline original is still there and still correct everywhere else. These exist
  because a 2dp stroke inside a 32dp coloured tile turns to mush: the stroke is a fixed
  width but the tile shrank, so the glyph loses its counters and reads as a white smudge.
  A solid shape has no such problem and is what the reference uses in the same place.

  Geometry is original work on a 24x24 grid, not traced from any shipping icon set.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12,3.8 a8.2,8.2 0 1,0 0.01,0 z M12,6.0 a6.0,6.0 0 1,0 0.01,0 z M10.6,3.95 h2.8 v1.95 h-2.8 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.85,2.6 h2.3 a1.15,1.15 0 0 1 1.15,1.15 v7.0 a1.15,1.15 0 0 1 -1.15,1.15 h-2.3 a1.15,1.15 0 0 1 -1.15,-1.15 v-7.0 a1.15,1.15 0 0 1 1.15,-1.15 z" />
</vector>
