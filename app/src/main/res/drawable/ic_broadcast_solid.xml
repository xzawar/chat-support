<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled counterpart of ic_broadcast, for Settings rows only.

  The outline original is still there and still correct everywhere else. These exist
  because a 2dp stroke inside a 32dp coloured tile turns to mush: the stroke is a fixed
  width but the tile shrank, so the glyph loses its counters and reads as a white smudge.
  A solid shape has no such problem and is what the reference uses in the same place.

  Geometry is original work on a 24x24 grid, not traced from any shipping icon set.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12,2.4 a9.6,9.6 0 1,0 0.01,0 z M12,3.6 a8.4,8.4 0 1,0 0.01,0 z M12,5.4 a6.6,6.6 0 1,0 0.01,0 z M12,6.6 a5.4,5.4 0 1,0 0.01,0 z M12,9.6 a2.4,2.4 0 1,0 0.01,0 z" />
</vector>
