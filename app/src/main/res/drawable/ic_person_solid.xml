        android:fillColor="#FF000000"
        android:pathData="M12,3.2 a4.4,4.4 0 1,0 0.01,0 z M12,13.6 c-4.6,0 -8.4,2.7 -8.4,6.1 0,0.62 0.5,1.1 1.1,1.1 h14.6 c0.6,0 1.1,-0.48 1.1,-1.1 0,-3.4 -3.8,-6.1 -8.4,-6.1 z" />
</vector>
