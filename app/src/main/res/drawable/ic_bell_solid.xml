        android:fillColor="#FF000000"
        android:pathData="M12,2.4 a5.8,5.8 0 0 1 5.8,5.8 c0,4.5 1.9,6.1 1.9,6.1 h-15.4 c0,0 1.9,-1.6 1.9,-6.1 a5.8,5.8 0 0 1 5.8,-5.8 z M9.85,15.8 h4.3 a2.15,2.15 0 0 1 -4.3,0 z" />
