# Copy to functions/.env for local emulator runs. The functions emulator reads it automatically.
#
# In production these are Cloud Functions secrets instead, set with:
#   firebase functions:secrets:set WIDGET_JWT_SECRET
#   firebase functions:secrets:set BILLING_CALLBACK_SECRET
#
# There is no in-repo fallback for either. A default secret that works is a default secret that
# ships, so an unset value throws at first use rather than quietly signing forgeable tokens.
# Minimum 16 characters.

WIDGET_JWT_SECRET=local-dev-widget-secret-0123456789
BILLING_CALLBACK_SECRET=local-dev-billing-secret-0123456789

# Optional. Returned to the widget in its public Firebase config; unset is fine on the emulator.
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=

# Optional. Restricts who may run POST /v1/bootstrap to one uid or email. The emulator seed writes
# the bootstrap lock directly, so this is not needed locally.
# BOOTSTRAP_ADMIN=

# Optional. "sandbox" auto-approves checkout, which is the current behaviour and stays as-is.
# BILLING_PROVIDER=sandbox
